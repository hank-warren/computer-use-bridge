  "bugs": "https://github.com/hank-warren/computer-use-bridge/issues",
  "license": "MIT",
  "author": "Hank Warren",
  "type": "module",
  "bin": { "computer-use-bridge": "bin/computer-use-bridge.mjs" },
  "files": ["bin", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "os": ["darwin", "linux"],
  "scripts": {
